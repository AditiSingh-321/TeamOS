NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use the same origin in the browser and in Supabase Auth URL Configuration.
TEAMOS_SITE_URL=http://localhost:3000
TEAMOS_GOOGLE_AUTH_ENABLED=false

# Sarvam powers all AI features (planner, follow-ups, and document answers)
SARVAM_API_KEY=replace_me
SARVAM_MODEL=sarvam-105b

# PostgreSQL text retrieval works without embedding API access.
RAG_RETRIEVAL_MODE=fulltext
# Optional semantic mode requires Sarvam Provisioned Throughput access.
SARVAM_EMBEDDING_MODEL=embeddinggemma-2
RAG_CHUNK_TOKENS=650
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# Trusted document and intelligence workers only. Never prefix with NEXT_PUBLIC_ or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Risk and meeting intelligence reuse SARVAM_API_KEY and SARVAM_MODEL above.
# Start the durable intelligence process with pnpm worker:intelligence.

# UTC calendar days ahead for task reminders (0–14); intelligence worker scans every minute.
NOTIFICATION_DUE_SOON_DAYS=1

# Server-only, >=32 random characters; generate a separate value in each deployment.
TEAMOS_RECOVERY_SECRET=replace_me_with_a_random_server_only_secret
